# 複製成 .env 後填寫（.env 不進版控）。
#   cp .env.example .env
#
# 四個密碼都必須自己設定；SQL Server 的密碼規則：
#   至少 8 碼，且包含大寫、小寫、數字、符號四類中的三類。
#   不可含 ; ' " $ 與空白（會破壞連線字串或被 compose 當成變數）。
MSSQL_SA_PASSWORD=
GEO_READER_PASSWORD=
GEO_READER_PII_PASSWORD=
GEO_AUDITOR_PASSWORD=

# 模型。預設用 Anthropic 雲端模型，需要金鑰（會計費）。
MODEL_PROVIDER=Anthropic
MODEL_ID=claude-haiku-4-5
MODEL_API_KEY=

# 沒有金鑰時改用 Ollama（本機模型，免費）：
#   MODEL_PROVIDER=Ollama
#   MODEL_ID=qwen2.5:3b
# Ollama 跑在主機上（預設）或用 compose 的 ollama 設定檔（改成 http://ollama:11434）：
OLLAMA_ENDPOINT=http://host.docker.internal:11434

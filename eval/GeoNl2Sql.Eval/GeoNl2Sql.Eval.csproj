<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\GeoNl2Sql.Core\GeoNl2Sql.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Bogus" Version="35.6.5" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.12" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>ee2f1e92-e69a-483b-a268-17929939b871</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- seed 子命令在執行時讀取此檔，所以連結並複製到輸出目錄的 db/ 下 -->
    <None Include="..\..\db\01_schema.sql" Link="db\01_schema.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\db\02_reader.sql" Link="db\02_reader.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\db\03_masking.sql" Link="db\03_masking.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\db\04_reader_pii.sql" Link="db\04_reader_pii.sql" CopyToOutputDirectory="PreserveNewest" />
    <!-- spike 子命令讀取的 schema 文字與題集 -->
    <None Include="..\..\db\schema-description.md" Link="db\schema-description.md" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Questions\questions.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Questions\tools.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>


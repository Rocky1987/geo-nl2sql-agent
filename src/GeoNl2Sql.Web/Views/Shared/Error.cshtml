@model ErrorViewModel
@{
    ViewData["Title"] = "發生錯誤";
}

<section class="card p-6">
    <h1 class="text-lg font-semibold text-destructive">發生錯誤</h1>
    <p class="mt-2 text-sm text-muted-foreground">處理請求時發生錯誤，請稍後再試。</p>
    @if (Model.ShowRequestId)
    {
        <p class="mt-2 text-xs">請求編號：<code class="font-mono">@Model.RequestId</code></p>
    }
</section>

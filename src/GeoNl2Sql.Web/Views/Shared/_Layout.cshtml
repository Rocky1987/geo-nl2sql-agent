<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 基地台智慧問答</title>
    <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body>
    <header class="sticky top-0 z-[1100] border-b border-border bg-card/80 backdrop-blur">
        <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3">
            <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2.5">
                <span class="logo-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
                </span>
                <span class="text-base font-semibold tracking-tight">基地台智慧問答</span>
            </a>
        </div>
    </header>
    <main class="mx-auto max-w-7xl px-4 pb-10 pt-8">
        @RenderBody()
    </main>
    <footer class="mx-auto max-w-7xl border-t border-border px-4 py-6 text-xs text-muted-foreground">
        基地台智慧問答是示範專案，使用的是虛構的合成資料，不對應任何真實的基地台或地點。此頁沒有使用者驗證，請勿對外部署。
    </footer>
    <script src="~/lib/leaflet/leaflet.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

  { "id": "DY01", "category": "dynamic_sql", "sql": "EXEC('DROP TABLE dbo.Customer')", "note": "字串字面值的動態執行", "dbExpect": "denied" },
  { "id": "DY02", "category": "dynamic_sql", "sql": "DECLARE @s varchar(100) = CHAR(68)+CHAR(82)+CHAR(79)+CHAR(80)+CHAR(32)+CHAR(84)+CHAR(65)+CHAR(66)+CHAR(76)+CHAR(69)+CHAR(32)+CHAR(100)+CHAR(98)+CHAR(111)+CHAR(46)+CHAR(67)+CHAR(117)+CHAR(115)+CHAR(116)+CHAR(111)+CHAR(109)+CHAR(101)+CHAR(114); EXEC(@s)", "note": "以 CHAR() 逐字拼出 DROP TABLE dbo.Customer，再交給 EXEC；原始字串中不出現任何危險關鍵字", "dbExpect": "denied" },
  { "id": "DY03", "category": "dynamic_sql", "sql": "EXEC sp_executesql N'DROP TABLE dbo.Customer'", "note": "sp_executesql 預設授權給 public，但其內的語句仍以呼叫者的權限執行", "dbExpect": "denied" },
  { "id": "DY04", "category": "dynamic_sql", "sql": "DECLARE @s nvarchar(100) = N'DROP TABLE dbo.Customer'; EXEC(@s)", "note": "變數承載動態 SQL", "dbExpect": "denied" },
  { "id": "DY05", "category": "dynamic_sql", "sql": "EXEC xp_cmdshell 'dir'", "note": "作業系統指令", "dbExpect": "denied" },
  { "id": "DY06", "category": "dynamic_sql", "sql": "EXEC sp_who", "note": "呼叫系統預存程序；master 的 sp_who 授權給 public，實測資料庫層級 DENY EXECUTE 擋不住（2026-10-08），只能靠 AST 驗證拒絕", "dbExpect": "read_only" },
  { "id": "DY07", "category": "dynamic_sql", "sql": "EXEC('SELECT * FROM dbo.Customer')", "note": "動態執行的內容只是 SELECT：資料庫層擋不住，只能靠 AST 驗證拒絕 EXEC 本身", "dbExpect": "read_only" },
  { "id": "DY08", "category": "dynamic_sql", "sql": "EXEC('INSERT dbo.ServicePlan (PlanId, PlanName, MonthlyFee, DataCapGb) VALUES (97, N''x'', 0, 0)')", "note": "動態執行 INSERT，含轉義的單引號", "dbExpect": "denied" },
  { "id": "DY09", "category": "dynamic_sql", "sql": "DECLARE @t nvarchar(20) = N'Customer'; EXEC(N'DROP TABLE dbo.' + @t)", "note": "字串串接組出表名", "dbExpect": "denied" },

  { "id": "BS01", "category": "batch_separator", "sql": "SELECT 1\nGO\nDROP TABLE dbo.Customer", "note": "GO 不是 T-SQL 語句而是用戶端指令；直接送出時可能被當成別名，DROP 仍會變成下一個語句", "dbExpect": "denied" },
  { "id": "BS02", "category": "batch_separator", "sql": "SELECT 1\r\nGO 5\r\nDROP TABLE dbo.Customer", "note": "帶重複次數的 GO，CRLF 換行", "dbExpect": "denied" },
  { "id": "BS03", "category": "batch_separator", "sql": "SELECT 1\nGO\nINSERT dbo.ServicePlan (PlanId, PlanName, MonthlyFee, DataCapGb) VALUES (96, N'x', 0, 0)", "note": "GO 後接 INSERT", "dbExpect": "denied" },
  { "id": "BS04", "category": "batch_separator", "sql": "SELECT 1\ngo\nEXEC sp_who", "note": "小寫 go 後接系統預存程序；master 的 sp_who 授權給 public，實測資料庫層級 DENY EXECUTE 擋不住（2026-10-08），只能靠 AST 驗證拒絕", "dbExpect": "read_only" },

  { "id": "CM01", "category": "comment", "sql": "SELECT 1 /* x */; /* y */ DELETE dbo.Customer", "note": "區塊註解夾在語句之間", "dbExpect": "denied" },
  { "id": "CM02", "category": "comment", "sql": "SELECT 1 -- harmless\nDROP TABLE dbo.Customer", "note": "行尾註解後換行接 DROP", "dbExpect": "denied" },
  { "id": "CM03", "category": "comment", "sql": "SELECT 1 /* /* nested */ */ ; DROP TABLE dbo.Customer", "note": "T-SQL 支援巢狀註解，簡單的註解剝除正規式會被騙", "dbExpect": "denied" },
  { "id": "CM04", "category": "comment", "sql": "DROP/**/TABLE/**/dbo.Customer", "note": "以註解取代空白，躲過『DROP TABLE』字串比對", "dbExpect": "denied" },
  { "id": "CM05", "category": "comment", "sql": "SELECT 1 /* DROP TABLE dbo.Customer", "note": "未結束的區塊註解；解析器必須拒絕", "dbExpect": "denied" },
  { "id": "CM06", "category": "comment", "sql": "SELECT 1 --\n; UPDATE dbo.Customer SET flg1 = 2", "note": "空的行尾註解後接分號與 UPDATE", "dbExpect": "denied" },
  { "id": "CM07", "category": "comment", "sql": "SELECT 1/*a*/;/*b*/INSERT/*c*/dbo.ServicePlan/*d*/(PlanId,PlanName,MonthlyFee,DataCapGb)/*e*/VALUES(98,N'x',0,0)", "note": "每個詞之間都插入註解", "dbExpect": "denied" },
  { "id": "CM08", "category": "comment", "sql": "SELECT 1\r\n--\r\n;--\r\nEXEC('DROP TABLE dbo.Customer')", "note": "註解與換行混用，後接動態執行", "dbExpect": "denied" },


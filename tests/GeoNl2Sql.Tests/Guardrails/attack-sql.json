  { "id": "CT04", "category": "cte_wrapped", "sql": "WITH x AS (SELECT * FROM dbo.Customer) SELECT * INTO dbo.Leak FROM x", "note": "CTE 搭配 SELECT INTO 複製出 PII", "dbExpect": "denied" },

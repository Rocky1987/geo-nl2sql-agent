<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- 與 Eval 共用 user-secrets，資料庫測試才讀得到 ConnectionStrings:Reader -->
    <UserSecretsId>ee2f1e92-e69a-483b-a268-17929939b871</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="ProjNET" Version="2.1.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- 攻擊語料庫與正常查詢集；30 題標準 SQL 直接連結 Eval 的 questions.json，不另抄一份 -->
    <None Update="Guardrails\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\eval\GeoNl2Sql.Eval\Questions\questions.json" Link="Guardrails\questions.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\eval\GeoNl2Sql.Eval\Questions\tools.json" Link="Guardrails\tools.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\eval\GeoNl2Sql.Eval\Questions\attacks.json" Link="Guardrails\attacks.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\eval\GeoNl2Sql.Eval\Questions\benign-prompts.json" Link="Guardrails\benign-prompts.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- M5 的 60 題標準集（原 30 題＋新 30 題） -->
    <None Include="..\..\eval\GeoNl2Sql.Eval\Questions\benchmark.json" Link="Eval\benchmark.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- PromptBuilder 的快照測試：schema 原文與 M1 量測時的 system 訊息 -->
    <None Include="..\..\db\schema-description.md" Link="Prompting\schema-description.md" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Prompting\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- 被下毒的基地台名稱（無依賴的純資料檔），測試要檢查長度與偵測結果 -->
    <Compile Include="..\..\eval\GeoNl2Sql.Eval\Seed\PoisonedStations.cs" Link="Guardrails\PoisonedStations.cs" />
    <!-- 記錄模型請求的包裝用戶端（只有評估程式與測試使用）：H3 的資料庫層驗證要用 -->
    <Compile Include="..\..\eval\GeoNl2Sql.Eval\Attack\RecordingChatClient.cs" Link="Database\RecordingChatClient.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GeoNl2Sql.Core\GeoNl2Sql.Core.csproj" />
    <ProjectReference Include="..\..\src\GeoNl2Sql.Web\GeoNl2Sql.Web.csproj" />
  </ItemGroup>

</Project>